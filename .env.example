# Log-processing limits (these values are examples; set them in the process environment).
AUTORCA_MAX_LOG_BYTES=5242880
AUTORCA_MAX_LOG_LINE_CHARS=65536
AUTORCA_MAX_MALFORMED_EXAMPLES=100

# The current investigation agent uses a deterministic local fallback.
# No AI provider API key is required. This example file is not auto-loaded.

# Switch integration (offline mock by default). Never put credentials in frontend code.
AUTORCA_SWITCH_MODE=mock
# For live mode, set mode=live and provide the registered agent credentials and target room.
# AUTORCA_SWITCH_AGENT_BASE_URL=https://switch-agent-api.example.invalid
# AUTORCA_SWITCH_AGENT_ID=
# AUTORCA_SWITCH_AGENT_API_KEY=
# AUTORCA_SWITCH_ROOM_ID=
# AUTORCA_SWITCH_CONNECTION_ID=<stable-uuid>
# AUTORCA_SWITCH_AGENT_NAME=autorca
# Optional exact Switch agent name to mention for responder requests.
# AUTORCA_SWITCH_TARGET_AGENT=
# AUTORCA_SWITCH_OUTBOX_PATH=data/autorca_switch.sqlite3
# AUTORCA_SWITCH_TIMEOUT_SECONDS=5
# Registration is explicit and one-time: set AUTORCA_SWITCH_REGISTRATION_API_KEY only when running
# python -m backend.switch_register, then remove it from the environment.
